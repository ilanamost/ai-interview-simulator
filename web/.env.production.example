# Production environment template — used for every real deployment, not only
# a single "production" host. Copy to `web/.env.production` (gitignored) and
# fill in the real values for that specific host. `npm run build` runs `vite
# build`, whose default mode is already `production`, so it loads
# `.env.production` with no extra flag.
#
# There is deliberately no separate `.env.staging` file or `--mode staging`:
# this repo's security guardrail hook only recognizes `.local`/`.development`/
# `.production` as real (non-`.example`) secret-bearing env files, so staging
# and production share this same filename and Vite mode. What actually makes
# one deployment "staging" and another "production" is which values you put
# here on that specific host — a different `VITE_API_BASE_URL`, typically —
# never the filename.

# A deployed environment talks to a real `api/` instance — `mock` is the offline
# local demo source only.
VITE_INTERVIEW_SOURCE=http

# Origin of the self-hosted production `api/`. Placeholder — GitHub Pages serves
# static files only and cannot host `api/`, so this must point at wherever the
# backend actually runs (any Node 20+ host), never at localhost. No trailing
# slash, and that host's CORS_ORIGIN must name the Pages origin serving this
# frontend (https://ilanamost.github.io).
VITE_API_BASE_URL=https://api.example.com
