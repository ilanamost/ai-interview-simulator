# api/ — deployed-environment template, used for every real host (staging and
# production alike), not only a single "production" server.
#
# Copy to a file literally named .env on that host (api/ reads .env, not
# .env.production — the mode suffix here only names which kind of environment
# this template describes). See .doc/deployment.md, "Self-hosting api/".
#
# There is deliberately no separate .env.staging template: this repo's
# security guardrail hook only recognizes .local/.development/.production as
# real (non-.example) secret-bearing env files, so every deployed host —
# whichever tier you consider it — uses this same filename. What makes one
# host "staging" and another "production" is which values you put in each
# host's own .env, not the filename.
#
# GitHub Pages serves the frontend only; it cannot run this process or reach
# Postgres. api/ is self-hosted separately on any Node 20+ host, and the
# Pages-hosted frontend talks to it over HTTPS.
#
# SECRETS: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, ANTHROPIC_API_KEY and
# DATABASE_URL must be real values generated fresh per host. Never copy them
# from .env.example (those placeholders are public) and never reuse another
# host's — a shared signing key means a token minted on one host is valid on
# the other. Prefer your host's secret manager over a file on disk.
#
# What actually differs between hosts: CORS_ORIGIN, DATABASE_URL, and every
# secret. NODE_ENV is production on every deployed host.

# --- Runtime ---

# production for both staging and production — NODE_ENV picks runtime behavior,
# it is not a label for which deployment target you are on.
NODE_ENV=production

# Port the Express server listens on. Set to whatever the production host
# expects (many hosts inject their own PORT).
PORT=3001

# --- Data ---

# Production's PostgreSQL database. Run api/schema.sql against it before first
# boot. Use a least-privilege application role, not a superuser.
DATABASE_URL=postgres://interview_app:REPLACE_ME@db.example.com:5432/interview_production

# The org every signup lands in — the app is still single-org.
ORG_ID=default

# --- LLM (server-side only; this key is never exposed to the browser) ---

# A production-only Anthropic key, so its spend and rate limits are tracked
# apart from staging's and revoking one doesn't take the other down.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_PRODUCTION_KEY

# Model used to generate interview questions.
LLM_QUESTION_MODEL=claude-sonnet-5

# Model used to evaluate submitted answers.
LLM_EVAL_MODEL=claude-sonnet-5

# --- Browser access ---

# MUST name the exact origin the production frontend is served from — scheme +
# host + port, no trailing slash and no path. For the GitHub-Pages-hosted
# frontend that origin is https://ilanamost.github.io.
#
# Note it is the bare origin, NOT https://ilanamost.github.io/ai-dev/ — the
# /ai-dev/ path is Vite's base path, and a browser's Origin header never
# includes a path. Including it here would reject every request.
#
# Change this if the frontend moves to a custom domain, and keep
# web/.env.production's VITE_API_BASE_URL pointed at this server's URL.
CORS_ORIGIN=https://ilanamost.github.io

# --- Auth ---

# Freshly generated for production, and different from each other and from every
# other environment: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_FRESHLY_GENERATED_PRODUCTION_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_FRESHLY_GENERATED_PRODUCTION_SECRET

# Access token lifetime, in minutes.
ACCESS_TOKEN_TTL_MIN=15

# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30
