# api/ — local development template.
#
# Copy this file to api/.env and fill in real values. api/ has no mode system of
# its own: `npm run dev` and `npm start` both read a file literally named .env
# (see api/package.json). The real .env is gitignored and must never be committed.
#
# Every variable below is read and validated at startup by api/src/config/env.ts.
# For staging/production values see .env.staging.example / .env.production.example
# and .doc/deployment.md.

# --- Runtime ---

# Runtime mode. One of: development | test | production. Not a deployment-target
# label — staging and production both run with NODE_ENV=production.
NODE_ENV=development

# Port the Express server listens on.
PORT=3001

# --- Data ---

# PostgreSQL connection string. Run api/schema.sql against this database first.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interview_dev

# The org every signup lands in — the app is still single-org, and every
# repository query is scoped by it.
ORG_ID=default

# --- LLM (server-side only; this key is never exposed to the browser) ---

# Anthropic API key used to generate questions and evaluate answers.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_OWN_KEY

# Model used to generate interview questions.
LLM_QUESTION_MODEL=claude-sonnet-5

# Model used to evaluate submitted answers.
LLM_EVAL_MODEL=claude-sonnet-5

# --- Browser access ---

# The exact origin the frontend is served from (scheme + host + port, no path).
# Requests from any other origin are rejected by CORS. 5173 is Vite's dev server.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---

# Signing keys for the access and refresh tokens. There is deliberately no
# fallback in env.ts — a default secret would make every token forgeable.
# Generate your own, and a different one for each: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-replace-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-me

# Access token lifetime, in minutes.
ACCESS_TOKEN_TTL_MIN=15

# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30
